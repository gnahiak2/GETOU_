{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "GetouCompanion: Build (Debug)",
      "type": "shell",
      "command": "xcodebuild -project GetouCompanion/GetouCompanion.xcodeproj -scheme GetouCompanion -configuration Debug -destination 'platform=macOS' build",
      "problemMatcher": [
        "$swiftc"
      ],
      "group": "build"
    },
    {
      "label": "GetouCompanion: Clean",
      "type": "shell",
      "command": "xcodebuild -project GetouCompanion/GetouCompanion.xcodeproj -scheme GetouCompanion -configuration Debug -destination 'platform=macOS' clean",
      "problemMatcher": [],
      "group": "build"
    },
    {
      "label": "GetouCompanion: Build (Release)",
      "type": "shell",
      "command": "xcodebuild -project GetouCompanion/GetouCompanion.xcodeproj -scheme GetouCompanion -configuration Release -destination 'platform=macOS' build",
      "problemMatcher": [
        "$swiftc"
      ]
    }
  ]
}